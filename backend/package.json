{
  "name": "office-companion-backend",
  "private": true,
  "type": "module",
  "engines": {"node": ">=20"},
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:init": "tsx scripts/init-db.ts",
    "seed": "tsx scripts/seed.ts",
    "state:reset": "tsx scripts/reset-state.ts",
    "test": "vitest run",
